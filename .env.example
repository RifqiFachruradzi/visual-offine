# Salin menjadi .env (lokal) atau isi di Vercel → Settings → Environment Variables
# Kunci gratis: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Opsional: ganti model default Gemini (alias selalu menunjuk versi terbaru)
# GEMINI_MODEL=gemini-flash-latest
# Opsional: batas token output per agen
# LLM_MAX_OUTPUT_TOKENS=2048
# Opsional: aktifkan Claude untuk agen yang memilih model Claude
# ANTHROPIC_API_KEY=

# Login & penyimpanan akun: hubungkan Upstash Redis (Vercel → Storage → Upstash for Redis).
# KV_REST_API_URL & KV_REST_API_TOKEN terisi otomatis di Vercel. Lokal: salin dari dashboard Upstash.
KV_REST_API_URL=
KV_REST_API_TOKEN=
# Opsional: wajibkan kode undangan saat daftar, atau tutup pendaftaran
# REGISTER_CODE=kode-rahasia
# ALLOW_REGISTER=false

# Alternatif tanpa database (tanpa fitur daftar): akun tetap
# APP_USERNAME=
# APP_PASSWORD=
# APP_USERS=rifqi:passwordku,budi:pass2
# Opsional: kunci tanda tangan cookie (default diturunkan dari token database / password)
# APP_SECRET=
